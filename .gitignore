# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
env/

# Raw data cache: regenerated by `python -m src.pipeline`
data/raw/*.csv
data/raw/*.json
data/raw/*.zip
!data/raw/.gitkeep

# Generated artifacts (models are large binaries; metadata stays committed)
artifacts/models/*.pkl
artifacts/models/*.joblib

# Reports are committed intentionally for reproducibility, but keep temp output out
reports/**/*.tmp
reports/**/*.log

# Streamlit / OS noise
.streamlit/secrets.toml
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
